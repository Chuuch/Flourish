# Copy to the VPS as Flourish/.env.prod (never commit real secrets).

FLOURISH_IMAGE=ghcr.io/chuuch/flourish:latest

# Public site hostname (no scheme) — Caddy issues TLS for this name.
FLOURISH_SITE=app.example.com
CADDY_EMAIL=ops@example.com

# Same-origin API URL as seen by the browser.
APP_API_URL=https://app.example.com/api/v1

# Build-time (CI / docker build args), not always needed at runtime:
# VITE_APP_ENV=production
# VITE_API_URL=https://app.example.com/api/v1
# VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# VITE_APP_RELEASE=git-sha-or-semver
